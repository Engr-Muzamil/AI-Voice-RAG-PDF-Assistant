# These are NOT read by n8n directly. n8n stores credentials in its own
# encrypted credential store. This file exists so anyone cloning the repo
# knows exactly which secrets and identifiers they need to obtain.

# Mistral Cloud
MISTRAL_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=projects

# Google Drive OAuth2 (create in Google Cloud Console, enable Drive API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_AUTH_HEADER=
